# app
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
NEXT_PUBLIC_APP_NAME = "Your App Name"
NEXT_PUBLIC_DEFAULT_LOCALE = "zh"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "system"

# database
DATABASE_PROVIDER = "sqlite"
DATABASE_URL = "file:data/local.db"
DB_SCHEMA_FILE = "./src/config/db/schema.sqlite.ts"
DB_MIGRATIONS_OUT = "./src/config/db/migrations_sqlite"
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"

# assistant rate limiting and concurrency
UPSTASH_REDIS_REST_URL = ""
UPSTASH_REDIS_REST_TOKEN = ""
AI_RATE_LIMIT_PER_MINUTE = "12"
AI_MAX_CONCURRENT_REQUESTS = "2"

# AI assistant providers and optional web search
HONOURSOFT_API_KEY = ""
HONOURSOFT_API_BASE_URL = "https://cc.honoursoft.cn/v1"
DEEPSEEK_API_KEY = ""
DEEPSEEK_API_BASE_URL = "https://api.deepseek.com/v1"
AI_FALLBACK_PROVIDER_API_KEY = ""
AI_FALLBACK_PROVIDER_BASE_URL = ""
# Optional emergency kill switch; model-level support is configured in admin.
AI_REASONING_ENABLED = "true"
TAVILY_API_KEY = ""
AI_WEB_SEARCH_COST_USD = ""
AI_WEB_SEARCH_API_KEY_ENV = "TAVILY_API_KEY"
AI_WEB_SEARCH_URL = "https://api.tavily.com/search"
AI_IMAGE_INPUT_TOKENS = "1200"

# Vercel Cron calls the private 30-day deletion worker with this bearer secret
CRON_SECRET = ""
REFERRAL_COOKIE_SECRET = ""

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""
